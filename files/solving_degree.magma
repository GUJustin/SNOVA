// Solving-degree experiment for concern #1 (run on a machine with Magma).
// Measures the ACTUAL max step degree Faugere F4 reaches on a residual system,
// to be compared against the semi-regular prediction from semireg_dreg.py.
//
// INPUT CONTRACT: a file `system.mag` defining
//     q  := 19;
//     n  := <number of variables>;
//     F  := [ ... ];   // list of quadratic polynomials in R.1..R.n over GF(q)
// Your generator (the affine-column reduction) should emit the residual system
// in exactly this form (one determined subsystem AFTER Hashimoto specialization,
// OR the raw underdetermined system if you want to observe its full behavior).

SetVerbose("Groebner", 1);          // prints per-step degrees to stdout
q  := 19;
load "system.mag";                  // defines q, n, F
R  := PolynomialRing(GF(q), n, "grevlex");
polys := [ R | f : f in F ];
t0 := Cputime();
G  := GroebnerBasis(polys);         // F4; step degrees appear in verbose trace
t1 := Cputime();
maxdeg := Max([ TotalDegree(g) : g in G ]);
printf "n=%o  #eqs=%o  max GB degree=%o  cpu=%o s\n", n, #polys, maxdeg, t1-t0;
printf "Compare max step degree in the verbose trace above to the semi-regular D_reg.\n";
